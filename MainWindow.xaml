<Window x:Class="DirectoryManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DirectoryManagement.Services"
        Title="DirectoryManagement"
        Height="780"
        Width="980"
        MinHeight="680"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="16,16,16,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="6" />
            <RowDefinition x:Name="LogPanelRow" Height="168" MinHeight="130" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <Grid Margin="0,0,0,6" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="UpFolderButton" Style="{StaticResource ModernButton}" MinWidth="118" IsEnabled="False"
                            Click="UpFolderButton_Click" loc:Localize.ToolTipKey="UpFolderTip">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE110;" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="UpFolderLabel" loc:Localize.TextKey="UpFolder" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RescanButton" Style="{StaticResource ModernButton}" MinWidth="130" Margin="8,0,0,0"
                            Click="RescanButton_Click" loc:Localize.ToolTipKey="RescanTip">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="RescanLabel" loc:Localize.TextKey="Rescan" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteBinObjToolbarButton" Style="{StaticResource ModernButton}" MinWidth="130" Margin="8,0,0,0"
                            Click="DeleteBinObjToolbarButton_Click"
                            loc:Localize.ToolTipKey="BinObjSilTip">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE943;" FontSize="14"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="DeleteBinObjToolbarLabel" loc:Localize.TextKey="BinObjSil" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteSelectedToolbarButton" Style="{StaticResource ModernButton}" MinWidth="130" Margin="8,0,0,0"
                            Click="DeleteSelectedToolbarButton_Click"
                            loc:Localize.ToolTipKey="DeleteAllTip">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="DeleteSelectedToolbarLabel" loc:Localize.TextKey="DeleteAll" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggleButton"
                            Style="{StaticResource ModernButton}"
                            MinWidth="72"
                            Height="30"
                            Padding="8,4"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Click="ThemeToggleButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ThemeToggleIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE708;"
                                       FontSize="14"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ThemeToggleLabel"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="LanguageComboBox"
                              Style="{StaticResource ModernComboBox}"
                              Width="96"
                              VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                <TextBlock x:Name="LocationLabel" loc:Localize.TextKey="Location"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource IconGhostButton}"
                        Click="CopyLocationButton_Click"
                        loc:Localize.ToolTipKey="CopyPathTip"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Margin="2,0,4,0"
                        VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE8C8;"
                               FontSize="14"
                               Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <TextBlock Text=":"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox x:Name="LocationPathBox"
                         Style="{StaticResource ModernTextBox}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         TextWrapping="NoWrap"
                         MinWidth="120"
                         Cursor="IBeam" />
            </StackPanel>
            <TextBlock x:Name="HelpHintText" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="12"
                       loc:Localize.TextKey="HelpHint" />
        </StackPanel>

        <DataGrid x:Name="SizeGrid"
                  Grid.Row="1"
                  Style="{StaticResource ModernDataGrid}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  RowHeight="38"
                  ColumnHeaderHeight="38"
                  VerticalAlignment="Stretch"
                  VerticalScrollBarVisibility="Auto"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  SelectionChanged="SizeGrid_SelectionChanged"
                  PreviewMouseLeftButtonDown="SizeGrid_PreviewMouseLeftButtonDown"
                  MouseDoubleClick="SizeGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="SelectColumn" Header="Seç" Width="48">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelectedForCleanup, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanDelete}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Checked="CleanupCheckBox_Changed"
                                      Unchecked="CleanupCheckBox_Changed" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="*" MinWidth="160">
                    <DataGridTemplateColumn.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Tag="Name" Cursor="Hand"
                                    Background="Transparent" loc:Localize.ToolTipKey="SortNameTip"
                                    MouseLeftButtonDown="SortColumnHeader_MouseLeftButtonDown">
                            <TextBlock x:Name="ColNameHeader" Style="{StaticResource DataGridHeaderLabel}" loc:Localize.TextKey="ColName" />
                            <Button Style="{StaticResource DataGridHeaderButton}"
                                    Tag="Name" Click="SortColumnHeader_Click" loc:Localize.ToolTipKey="SortNameTip">
                                <TextBlock x:Name="SortGlyphName" Style="{StaticResource DataGridHeaderGlyph}"
                                           Foreground="{DynamicResource ForegroundMutedBrush}" Opacity="0.35" Text="&#xE70E;" />
                            </Button>
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"
                                         Loaded="RenameTextBox_Loaded"
                                         KeyDown="RenameTextBox_KeyDown"
                                         LostFocus="RenameTextBox_LostFocus">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="168" MinWidth="150">
                    <DataGridTemplateColumn.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Tag="Type" Cursor="Hand"
                                        Background="Transparent" loc:Localize.ToolTipKey="SortTypeTip"
                                        MouseLeftButtonDown="SortColumnHeader_MouseLeftButtonDown">
                                <TextBlock x:Name="ColTypeHeader" Style="{StaticResource DataGridHeaderLabel}" loc:Localize.TextKey="ColType" />
                                <Button Style="{StaticResource DataGridHeaderButton}"
                                        Tag="Type" Click="SortColumnHeader_Click" loc:Localize.ToolTipKey="SortTypeTip">
                                    <TextBlock x:Name="SortGlyphType" Style="{StaticResource DataGridHeaderGlyph}"
                                               Foreground="{DynamicResource ForegroundMutedBrush}" Opacity="0.35" Text="&#xE70E;" />
                                </Button>
                            </StackPanel>
                            <Button Style="{StaticResource DataGridHeaderButton}" Margin="2,0,0,0"
                                    Click="TypeFilterButton_Click" loc:Localize.ToolTipKey="TypeFilterTip">
                                <TextBlock x:Name="TypeFilterGlyph" Style="{StaticResource DataGridHeaderGlyph}"
                                           Foreground="{DynamicResource PrimaryBrush}" Text="&#xE71C;" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="TypeFilterAllMenuItem" Header="Tümü" IsCheckable="True"
                                                  Click="TypeFilterMenu_Click" Tag="All" />
                                        <MenuItem x:Name="TypeFilterFolderMenuItem" Header="Yalnızca klasör" IsCheckable="True"
                                                  Click="TypeFilterMenu_Click" Tag="Folders" />
                                        <MenuItem x:Name="TypeFilterFileMenuItem" Header="Yalnızca dosya" IsCheckable="True"
                                                  Click="TypeFilterMenu_Click" Tag="Files" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" Margin="0,0,4,0"
                                           Text="{Binding Type, Converter={StaticResource TypeDisplayConverter}}" />
                                <Button Style="{StaticResource IconGhostButton}"
                                        Click="CopyItemPathButton_Click"
                                        Tag="{Binding}"
                                        loc:Localize.ToolTipKey="CopyPathTip"
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE8C8;"
                                               FontSize="13"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="132" MinWidth="120">
                    <DataGridTemplateColumn.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Tag="Size" Cursor="Hand"
                                    Background="Transparent" loc:Localize.ToolTipKey="SortSizeTip"
                                    MouseLeftButtonDown="SortColumnHeader_MouseLeftButtonDown">
                            <TextBlock x:Name="ColSizeHeader" Style="{StaticResource DataGridHeaderLabel}" loc:Localize.TextKey="ColSize" />
                            <Button Style="{StaticResource DataGridHeaderButton}"
                                    Tag="Size" Click="SortColumnHeader_Click" loc:Localize.ToolTipKey="SortSizeTip">
                                <TextBlock x:Name="SortGlyphSize" Style="{StaticResource DataGridHeaderGlyph}"
                                           Foreground="{DynamicResource PrimaryBrush}" Opacity="1" Text="&#xE70D;" />
                            </Button>
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SizeDisplay}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="ActionsColumn" Header="İşlemler" Width="248" MinWidth="220">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="1,0,0,0" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="1,0,0,0" />
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource IconGhostButton}"
                                        Click="OpenItemInExplorerButton_Click"
                                        Tag="{Binding}"
                                        loc:Localize.ToolTipKey="OpenExplorerTip"
                                        Width="32"
                                        Height="28"
                                        Margin="0,0,2,0"
                                        IsEnabled="{Binding CanDelete}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE8A7;"
                                               FontSize="16"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Button>
                                <Button Style="{StaticResource IconGhostButton}"
                                        Click="RenameItemButton_Click"
                                        Tag="{Binding}"
                                        loc:Localize.ToolTipKey="RenameTip"
                                        Width="32"
                                        Height="28"
                                        Margin="0,0,2,0"
                                        IsEnabled="{Binding CanRename}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE8AC;"
                                               FontSize="16"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Button>
                                <Button Style="{StaticResource ModernButton}"
                                        Click="DeleteBinObjRowButton_Click"
                                        Tag="{Binding}"
                                        loc:Localize.ToolTipKey="BinObjRowTip"
                                        Padding="6,2"
                                        MinWidth="0"
                                        Height="28"
                                        Margin="0,0,2,0"
                                        IsEnabled="{Binding IsFolder}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE943;" FontSize="13"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock loc:Localize.TextKey="BinObjSil" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource IconGhostButton}"
                                        Click="DeleteItemButton_Click"
                                        Tag="{Binding}"
                                        loc:Localize.ToolTipKey="DeleteItemTip"
                                        Width="32"
                                        Height="28"
                                        IsEnabled="{Binding CanDelete}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE74D;"
                                               FontSize="16"
                                               Foreground="{DynamicResource DangerBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2"
                      Height="6"
                      Margin="0,4,0,4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeDirection="Rows"
                      ShowsPreview="True"
                      Background="{DynamicResource BorderBrush}"
                      Cursor="SizeNS" />

        <Grid Grid.Row="3" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="88" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <GroupBox x:Name="LogGroupBox" Grid.Row="0" Header="Günlük" Padding="6" Margin="0,0,0,10">
                <TextBox x:Name="LogBox"
                         Style="{StaticResource ModernTextBox}"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         MinHeight="76"
                         VerticalAlignment="Stretch" />
            </GroupBox>
            <Grid Grid.Row="1" MinHeight="44" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="ScanProgress" Width="220" Height="18" Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" Margin="0,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="ClearLogButton"
                        Grid.Column="1"
                        Style="{StaticResource ModernButton}"
                        MinWidth="118"
                        MinHeight="36"
                        Padding="12,8"
                        VerticalAlignment="Center"
                        Click="ClearLogButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE894;" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ClearLogLabel" loc:Localize.TextKey="ClearLog" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
