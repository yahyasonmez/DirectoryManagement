<Application x:Class="DirectoryManagement.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DirectoryManagement.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/ColorsLight.xaml" />
                <ResourceDictionary Source="Themes/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:TypeDisplayConverter x:Key="TypeDisplayConverter" />
            <DataTemplate x:Key="LanguageComboItemTemplate">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{Binding Flag}"
                           Width="22"
                           Height="14"
                           Margin="0,0,6,0"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True" />
                    <TextBlock Text="{Binding Code}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
