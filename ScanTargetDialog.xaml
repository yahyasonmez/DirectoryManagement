<Window x:Class="DirectoryManagement.ScanTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DirectoryManagement.Services"
        Title="DirectoryManagement — Tarama konumu"
        Height="736"
        Width="736"
        MinHeight="736"
        MinWidth="736"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <ImageBrush x:Key="FolderWindowShapeMask"
                    ImageSource="pack://application:,,,/Themes/directory-management-logo-noBg.png"
                    Stretch="Uniform"
                    AlignmentX="Center"
                    AlignmentY="Center" />
        <!-- Black ~70% transparent list surface (30% opacity) -->
        <SolidColorBrush x:Key="ScanListBackgroundBrush" Color="#80000000" />
        <SolidColorBrush x:Key="ScanListBorderBrush" Color="#66FFFFFF" />
        <!-- Path input: more opaque for readable text -->
        <SolidColorBrush x:Key="ScanPathBackgroundBrush" Color="#F2FFFFFF" />
        <SolidColorBrush x:Key="ScanPathBorderBrush" Color="#99A8B8C8" />
        <SolidColorBrush x:Key="ScanCaptionBackgroundBrush" Color="#99000000" />
    </Window.Resources>

    <Grid SnapsToDevicePixels="True"
          RenderOptions.BitmapScalingMode="HighQuality">
        <Grid OpacityMask="{StaticResource FolderWindowShapeMask}">
            <Image HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="pack://application:,,,/Themes/directory-management-logo-noBg.png"
                   Stretch="Uniform" />

            <Border Width="458"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,28,0,64"
                    Padding="14,12"
                    Background="Transparent"
                    BorderThickness="0">
                <StackPanel>
                    <Border Background="{StaticResource ScanCaptionBackgroundBrush}"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="0,0,0,8"
                            MouseLeftButtonDown="Chrome_MouseLeftButtonDown"
                            Cursor="SizeAll">
                        <TextBlock x:Name="ScanPromptText"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   loc:Localize.TextKey="ScanPrompt" />
                    </Border>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="LanguageComboBox"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernComboBox}"
                                  Width="90"
                                  FontSize="11"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                        <Button x:Name="CloseButton"
                                Grid.Column="2"
                                Style="{StaticResource ModernButton}"
                                Width="30"
                                Height="30"
                                Padding="0"
                                VerticalAlignment="Center"
                                loc:Localize.ToolTipKey="Cancel"
                                Click="CloseButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE711;"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Button>
                    </Grid>

                    <Border Background="{StaticResource ScanCaptionBackgroundBrush}"
                            CornerRadius="6"
                            Padding="8,5"
                            Margin="0,0,0,6">
                        <TextBlock x:Name="DrivesHintText"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="White"
                                   loc:Localize.TextKey="DrivesHint" />
                    </Border>

                    <Border Background="{StaticResource ScanListBackgroundBrush}"
                            BorderBrush="{StaticResource ScanListBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True"
                            Margin="0,0,0,10">
                        <ListBox x:Name="DriveList"
                                 Height="124"
                                 Style="{StaticResource ModernListBox}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="11"
                                 SelectionChanged="DriveList_SelectionChanged"
                                 MouseDoubleClick="DriveList_MouseDoubleClick">
                            <ListBox.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#66FFFFFF" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1B2430" />
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               Margin="2,1" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Margin="0,0,0,10">
                        <Border Background="{StaticResource ScanCaptionBackgroundBrush}"
                                CornerRadius="6"
                                Padding="8,5"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="FolderPathLabel"
                                       loc:Localize.TextKey="FolderPath"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="White" />
                        </Border>
                        <TextBox x:Name="PathBox"
                                 Style="{StaticResource ModernTextBox}"
                                 Background="{StaticResource ScanPathBackgroundBrush}"
                                 BorderBrush="{StaticResource ScanPathBorderBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 Height="42"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 TextChanged="PathBox_TextChanged" />
                    </StackPanel>

                    <Button HorizontalAlignment="Stretch"
                            Style="{StaticResource ModernButton}"
                            Padding="8,6"
                            Margin="0,0,0,8"
                            FontSize="11"
                            Click="BrowseButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;" FontSize="13"
                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="BrowseFolderLabel"
                                       loc:Localize.TextKey="BrowseFolder"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource ModernButton}"
                                MinWidth="0"
                                Padding="8,6"
                                Margin="0,0,5,0"
                                FontSize="11"
                                IsCancel="True"
                                Click="CancelButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="12"
                                           Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="CancelLabel"
                                           loc:Localize.TextKey="Cancel"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ScanButton}"
                                MinWidth="0"
                                Padding="8,6"
                                Margin="5,0,0,0"
                                FontSize="11"
                                IsDefault="True"
                                Click="StartButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="12"
                                           Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ScanLabel"
                                           loc:Localize.TextKey="Scan"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
