<Window x:Class="DirectoryManagement.ConfirmListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DirectoryManagement.Services"
        Width="720"
        SizeToContent="Height"
        MinHeight="200"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock FontFamily="Segoe MDL2 Assets"
                       Text="&#xE7BA;"
                       FontSize="28"
                       Foreground="#F7A600"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="MessageText"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </StackPanel>

        <ListBox x:Name="ItemList"
                 Grid.Row="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button MinWidth="100"
                    Margin="0,0,8,0"
                    Padding="10,6"
                    IsDefault="True"
                    Click="YesButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14"
                               Foreground="#C42B1C" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="YesLabel" loc:Localize.TextKey="Yes" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button MinWidth="100"
                    Padding="10,6"
                    IsCancel="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="14"
                               Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="NoLabel" loc:Localize.TextKey="No" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
